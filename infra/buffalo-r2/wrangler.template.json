{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "buffalo-original-worker-r2-private-lab",
  "main": "./controller.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "R2_CONTAINER",
        "class_name": "BuffaloOriginalProcessProbe"
      }
    ]
  },
  "containers": [
    {
      "name": "buffalo-original-worker-r2-private-lab",
      "class_name": "BuffaloOriginalProcessProbe",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "UNPUBLISHED_IMAGE_DIGEST_REQUIRED"
        }
      }
    }
  ],
  "exports": {
    "BuffaloOriginalProcessProbe": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "R2_MODE": "DISABLED",
    "R2_EXPECTED_SHA": "UNAPPROVED",
    "R2_IMAGE_DIGEST": "UNPUBLISHED"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buffalo-control-plane-race-lab-20261121",
      "database_id": "d1e23807-b076-4c36-8785-7b423fc41614"
    }
  ]
}
