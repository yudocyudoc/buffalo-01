{
  "name": "buffalo-full-private",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": []
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECTS",
        "class_name": "ProjectRuntime"
      }
    ]
  },
  "exports": {
    "ProjectRuntime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "containers": [
    {
      "name": "buffalo-full-private",
      "class_name": "ProjectRuntime",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "UNPUBLISHED_IMAGE_DIGEST_REQUIRED"
        }
      }
    }
  ],
  "vars": {
    "RUNTIME_ENABLED": "false"
  }
}
