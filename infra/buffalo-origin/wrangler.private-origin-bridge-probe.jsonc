{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "buffalo-private-origin-router-lab",
  "main": "./bridge-probe-controller.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "BUFFALO_CONTAINER",
        "class_name": "BuffaloHandshakeContainer"
      }
    ]
  },
  "containers": [
    {
      "name": "buffalo-private-origin-lab",
      "class_name": "BuffaloHandshakeContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "image": "registry.cloudflare.com/e0cb52526a69c0f48f001901a5b9a640/buffalo-private-origin@sha256:9db33d0be768d4f70e3dfed21b87b0d048f9a5a63739b8301b324deab020ec1d"
        }
      }
    }
  ],
  "exports": {
    "BuffaloHandshakeContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "BUFFALO_ORIGIN_MODE": "HANDSHAKE_ONLY_NO_AGENT_PROCESS",
    "BUFFALO_ORIGIN_COMMIT_SHA": "a8b1ad0c02d5c3367bd24962e8fd36d277a8135d",
    "BUFFALO_ORIGIN_MODEL_SHA256": "57fed6310be45c10c263aecb796eeb72f993b318c5bc770013ff35e014cb4f39",
    "BUFFALO_PROBE_MODE": "ONE_SHOT_NO_INFERENCE"
  },
  "triggers": {
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buffalo-control-plane-race-lab-20261121",
      "database_id": "d1e23807-b076-4c36-8785-7b423fc41614"
    }
  ]
}
